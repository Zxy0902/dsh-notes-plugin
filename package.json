{
  "name": "dsh-client-ui-notes",
  "version": "0.1.6",
  "description": "DSH 笔记插件：主面板阅读器 + 备忘录，支持 Markdown 左编右渲、txt 编辑、文件树与置顶。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zxy0902/dsh-notes-plugin.git"
  },
  "author": "Zxy0902",
  "homepage": "https://github.com/Zxy0902/dsh-notes-plugin#readme",
  "bugs": {
    "url": "https://github.com/Zxy0902/dsh-notes-plugin/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "notes",
    "markdown",
    "editor"
  ],
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/index.d.ts",
    "lib/index.d.ts.map",
    "lib/client.js",
    "lib/client.js.map",
    "lib/client/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "DEVELOPMENT.md",
    "VERIFICATION.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2"
  }
}
